// Subclass of IOUserAudioDevice so the driver can react to sample-rate changes from Core Audio.
// (Audio flavour only.)
#ifndef MicroBookAudioDevice_h
#define MicroBookAudioDevice_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <AudioDriverKit/IOUserAudioDevice.iig>

class IOUserAudioDriver;

class LOCALONLY MicroBookAudioDevice : public IOUserAudioDevice
{
public:
    static OSSharedPtr<MicroBookAudioDevice> Create(IOUserAudioDriver *in_driver,
                                                    bool in_supports_prewarming,
                                                    OSString *in_device_uid,
                                                    OSString *in_model_uid,
                                                    OSString *in_manufacturer_uid,
                                                    uint32_t in_zero_timestamp_period);

    virtual bool init(IOUserAudioDriver *in_driver,
                      bool in_supports_prewarming,
                      OSString *in_device_uid,
                      OSString *in_model_uid,
                      OSString *in_manufacturer_uid,
                      uint32_t in_zero_timestamp_period) override;

    virtual void free() override;

    virtual kern_return_t HandleChangeSampleRate(double in_sample_rate) override;

    // callback is a MBRateCallback (see MicroBookRate.h), passed as void* because iig cannot parse that header
    void SetRateCallback(void *callback, void *context);
};

#endif
