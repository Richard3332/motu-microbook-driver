// Device-level personality: the MicroBook reports vendor-specific class, so macOS leaves it
// unconfigured. This class selects configuration 1 so the interface personality can attach.
#ifndef MicroBookDevice_h
#define MicroBookDevice_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <USBDriverKit/IOUSBHostDevice.iig>

class MicroBookDevice : public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
};

#endif
